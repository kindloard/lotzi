{
  "name": "namastore-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "migration:repair-product-catalog": "ts-node -r tsconfig-paths/register src/scripts/repair-product-catalog-schema.ts",
    "migration:verify-product-measurement": "ts-node -r tsconfig-paths/register src/scripts/verify-product-measurement-migration.ts",
    "test": "jest --runInBand",
    "test:auth": "jest --runInBand src/tests/auth",
    "perf:auth": "ts-node -r tsconfig-paths/register src/scripts/auth-performance-smoke.ts",
    "perf:product-save": "ts-node --files -r tsconfig-paths/register src/scripts/product-save-latency-smoke.ts",
    "auth:bootstrap-admin": "ts-node -r tsconfig-paths/register src/scripts/auth-bootstrap-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.23",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.23",
    "@nestjs/platform-express": "^11.1.23",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.5.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "file-type": "^22.0.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.5",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.3",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.23",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^30.4.2",
    "prisma": "^5.20.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  }
}
