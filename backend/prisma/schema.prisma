  storeId       String        @map("store_id") @db.Uuid
  addressId     String?       @map("address_id") @db.Uuid
  addressRecipientName String? @map("address_recipient_name")
  addressRecipientPhone String? @map("address_recipient_phone")
  addressLine1  String?       @map("address_line1")
  addressLine2  String?       @map("address_line2")
  addressCity   String?       @map("address_city")
  addressState  String?       @map("address_state")
  addressPincode String?      @map("address_pincode")
  addressLatitude Decimal?    @map("address_latitude") @db.Decimal(10, 7)
  addressLongitude Decimal?   @map("address_longitude") @db.Decimal(10, 7)
