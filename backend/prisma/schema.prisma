  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@id([productImageId, productVariantId])
  @@map("product_image_variants")
}

model UploadAsset {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String?                 @map("store_id") @db.Uuid
  uploadedByUserId String                  @map("uploaded_by_user_id") @db.Uuid
  purpose          UploadPurpose
  status           UploadAssetStatus       @default(TEMP)
  sourceSha256     String                  @map("source_sha256") @db.VarChar(64)
  originalFilename String                  @map("original_filename")
  draftId          String?                 @map("draft_id") @db.VarChar(120)
  clientFileId     String?                 @map("client_file_id") @db.VarChar(120)
  mimeType         String                  @map("mime_type")
  width            Int
  height           Int
  bytes            Int
  failureReason    String?                 @map("failure_reason")
  originalProviderPublicId String?         @map("original_provider_public_id")
  originalSecureUrl        String?         @map("original_secure_url")
  cleanupAttemptedAt       DateTime?       @map("cleanup_attempted_at") @db.Timestamptz(3)
  cleanupSucceededAt       DateTime?       @map("cleanup_succeeded_at") @db.Timestamptz(3)
  cleanupAttemptCount      Int             @default(0) @map("cleanup_attempt_count")
  cleanupLastError         String?         @map("cleanup_last_error")
  expiresAt        DateTime?               @map("expires_at") @db.Timestamptz(3)
  attachedAt       DateTime?               @map("attached_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  store            Store?                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  uploadedBy       User                    @relation("UploadAssetUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  renditions       UploadAssetRendition[]
  productImage     ProductImage?

  @@index([originalProviderPublicId])
  @@index([storeId, purpose, sourceSha256])
  @@index([storeId, purpose, draftId, sourceSha256])
  @@index([storeId, purpose, status])
  @@index([status, expiresAt])
  @@index([cleanupSucceededAt, cleanupAttemptCount])
  @@index([uploadedByUserId, createdAt])
  @@map("upload_assets")
}

model UploadAssetRendition {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadAssetId    String              @map("upload_asset_id") @db.Uuid
  kind             UploadRenditionKind
  provider         UploadProvider      @default(CLOUDINARY)
  providerPublicId String?             @map("provider_public_id")
  secureUrl        String              @map("secure_url")
  transformation   String?
  format           String
  width            Int
  height           Int
  bytes            Int?
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadAsset      UploadAsset         @relation(fields: [uploadAssetId], references: [id], onDelete: Cascade)

  @@unique([uploadAssetId, kind])
  @@index([provider, providerPublicId])
  @@index([uploadAssetId])
  @@map("upload_asset_renditions")
}

