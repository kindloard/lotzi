generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  SUSPENDED
  DELETED
}

enum UserProviderType {
  EMAIL
  GOOGLE
  MULTI
}

enum IdentityProviderName {
  GOOGLE
}

enum OtpPurpose {
  EMAIL_SIGNUP
  EMAIL_CHANGE
}

enum PhoneOtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
  BLOCKED
  CONSUMED
}

enum CheckoutOnboardingFlowStatus {
  ADDRESS_COLLECTED
  OTP_SENT
  PHONE_VERIFIED
  COMPLETED
  EXPIRED
  ABANDONED
}

enum OtpProviderName {
  FAST2SMS
}

enum SessionRevokedReason {
  LOGOUT
  USER_REVOKED
  PASSWORD_RESET
  TOKEN_REUSE
  ROLE_CHANGED
