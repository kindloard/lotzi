enum StockReservationStatus {
  ACTIVE
  RELEASED
  FINALIZED
  EXPIRED
}

enum InventoryLocationType {
  STORE
  WAREHOUSE
  FULFILLMENT_CENTER
}

enum InventoryReservationStatus {
  ACTIVE
