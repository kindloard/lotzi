model User {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String           @unique @db.Citext
  fullName          String?          @map("full_name")
  passwordHash      String?          @map("password_hash")
  providerType      UserProviderType @default(EMAIL) @map("provider_type")
  emailVerified     Boolean          @default(false) @map("email_verified")
  avatarUrl         String?          @map("avatar_url")
  status            UserStatus       @default(PENDING)
  phone             String?
  phoneVerifiedAt   DateTime?        @map("phone_verified_at") @db.Timestamptz(3)
  loginCount        Int              @default(0) @map("login_count")
  failedAttempts    Int              @default(0) @map("failed_attempts")
  lockedUntil       DateTime?        @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?        @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?        @map("password_changed_at") @db.Timestamptz(3)
  authzVersion      Int              @default(1) @map("authz_version")
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  addresses               Address[]
  carts                   Cart[]
  orders                  Order[]
  checkoutSessions        CheckoutSession[]
  stockReservations       StockReservation[]
  identityProviders       IdentityProvider[]
  otpVerifications        OtpVerification[]
  phoneOtpVerifications   PhoneOtpVerification[]
  sessions                Session[]
  passwordResets          PasswordReset[]
  customerProfile         CustomerProfile?
  merchantProfile         MerchantProfile?
  accountDeletionRequests AccountDeletionRequest[]
  createdStores           Store[]               @relation("StoreCreatedBy")
  approvedStores          Store[]               @relation("StoreApprovedBy")
  userRoles               UserRoleAssignment[]  @relation("UserRoleUser")
  assignedUserRoles       UserRoleAssignment[]  @relation("UserRoleAssignedBy")
  storeMemberships        StoreMember[]         @relation("StoreMemberUser")
  invitedStoreMemberships StoreMember[]         @relation("StoreMemberInvitedBy")
  auditLogs               AuditLog[]            @relation("AuditActor")
  uploadedStoreMedia      StoreMedia[]          @relation("StoreMediaUploadedBy")
  uploadedAssets          UploadAsset[]         @relation("UploadAssetUploadedBy")
  idempotencyKeys         IdempotencyKey[]       @relation("IdempotencyKeyUser")
  reviewedStoreApprovals  StoreApprovalReview[] @relation("StoreApprovalReviewedBy")

  @@index([email, status])
  @@index([phone, status])
  @@index([status])
  @@map("users")
}

model IdentityProvider {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  provider       IdentityProviderName
  providerUserId String               @map("provider_user_id")
  providerEmail  String               @map("provider_email") @db.Citext
  metadata       Json                 @default("{}")
  linkedAt       DateTime             @default(now()) @map("linked_at") @db.Timestamptz(3)
  lastLoginAt    DateTime?            @map("last_login_at") @db.Timestamptz(3)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([providerEmail])
  @@map("identity_providers")
}

model OtpVerification {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  email         String     @db.Citext
  otpHash       String     @map("otp_hash")
  otpNonce      String     @map("otp_nonce")
  purpose       OtpPurpose
  metadata      Json       @default("{}")
  verified      Boolean    @default(false)
  verifiedAt    DateTime?  @map("verified_at") @db.Timestamptz(3)
  attemptCount  Int        @default(0) @map("attempt_count")
  sendCount     Int        @default(1) @map("send_count")
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz(3)
  cooldownUntil DateTime?  @map("cooldown_until") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId, purpose, verified, expiresAt])
  @@map("otp_verifications")
}

model CheckoutOnboardingFlow {
  id                    String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flowTokenHash         String                       @unique @map("flow_token_hash")
  idempotencyKeyHash    String?                      @unique @map("idempotency_key_hash")
  phoneNumber           String                       @map("phone_number")
  phoneProofHash        String?                      @map("phone_proof_hash")
  addressCiphertext     String                       @map("address_ciphertext")
  addressNonce          String                       @map("address_nonce")
  nextPath              String                       @map("next_path")
  status                CheckoutOnboardingFlowStatus @default(ADDRESS_COLLECTED)
  deviceFingerprintHash String                       @map("device_fingerprint_hash")
  expiresAt             DateTime                     @map("expires_at") @db.Timestamptz(3)
  phoneVerifiedAt       DateTime?                    @map("phone_verified_at") @db.Timestamptz(3)
  consumedAt            DateTime?                    @map("consumed_at") @db.Timestamptz(3)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  phoneOtpVerifications PhoneOtpVerification[]

  @@index([phoneNumber, status, createdAt])
  @@index([status, expiresAt])
  @@map("checkout_onboarding_flows")
}

model PhoneOtpVerification {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flowId            String                  @map("flow_id") @db.Uuid
  userId            String?                 @map("user_id") @db.Uuid
  phoneNumber       String                  @map("phone_number")
  otpHash           String                  @map("otp_hash")
  otpNonce          String                  @map("otp_nonce")
  otpReferenceId    String                  @unique @map("otp_reference_id")
  provider          OtpProviderName         @default(FAST2SMS)
  providerMessageId String?                 @map("provider_message_id")
  providerRawStatus String?                 @map("provider_raw_status")
  status            PhoneOtpStatus          @default(PENDING)
  attemptCount      Int                     @default(0) @map("attempt_count")
  sendCount         Int                     @default(1) @map("send_count")
  lastAttemptAt     DateTime?               @map("last_attempt_at") @db.Timestamptz(3)
  blockedUntil      DateTime?               @map("blocked_until") @db.Timestamptz(3)
  expiresAt         DateTime                @map("expires_at") @db.Timestamptz(3)
  cooldownUntil     DateTime?               @map("cooldown_until") @db.Timestamptz(3)
  idempotencyKey    String?                 @map("idempotency_key")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  flow              CheckoutOnboardingFlow  @relation(fields: [flowId], references: [id], onDelete: Cascade)
  user              User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([flowId, idempotencyKey])
  @@index([phoneNumber, status, createdAt])
  @@index([flowId, status, createdAt])
  @@index([status, expiresAt])
  @@map("phone_otp_verifications")
}

model Session {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  tokenFamilyId     String                @map("token_family_id") @db.Uuid
  refreshTokenHash  String                @unique @map("refresh_token_hash")
  refreshTokenJti   String?               @map("refresh_token_jti") @db.VarChar(64)
  refreshTokenParentJti String?           @map("refresh_token_parent_jti") @db.VarChar(64)
  refreshTokenIssuedAt DateTime?          @map("refresh_token_issued_at") @db.Timestamptz(3)
  clientSecretHash  String?               @map("client_secret_hash") @db.VarChar(128)
  deviceFingerprint String                @map("device_fingerprint")
  deviceMetadata    Json?                 @map("device_metadata")
  ipAddress         String?               @map("ip_address")
  userAgent         String?               @map("user_agent")
  expiresAt         DateTime              @map("expires_at") @db.Timestamptz(3)
  persistent        Boolean               @default(true)
  revoked           Boolean               @default(false)
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(3)
  revokedReason     SessionRevokedReason? @map("revoked_reason")
  lastSeenAt        DateTime              @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHistory    RefreshTokenHistory[]
  auditLogs         AuditLog[]

  @@index([userId, revoked, expiresAt])
  @@index([tokenFamilyId, revoked])
  @@index([tokenFamilyId, refreshTokenJti])
  @@index([deviceFingerprint])
  @@map("sessions")
}

model RefreshTokenHistory {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String    @map("session_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenFamilyId    String    @map("token_family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  refreshTokenJti  String?   @map("refresh_token_jti") @db.VarChar(64)
  replacementRefreshTokenJti String? @map("replacement_refresh_token_jti") @db.VarChar(64)
  deviceFingerprint String?  @map("device_fingerprint") @db.VarChar(128)
  consumedAt       DateTime  @default(now()) @map("consumed_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  reuseDetectedAt  DateTime? @map("reuse_detected_at") @db.Timestamptz(3)
  session          Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tokenFamilyId, expiresAt])
  @@index([userId, consumedAt])
  @@index([sessionId, refreshTokenJti])
  @@map("refresh_token_history")
}

model PasswordReset {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  selector      String    @unique
  verifierHash  String    @map("verifier_hash")
  verifierNonce String    @map("verifier_nonce")
  requestedIp   String?   @map("requested_ip")
  userAgentHash String?   @map("user_agent_hash")
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@map("password_resets")
}

model CustomerProfile {
  userId         String   @id @map("user_id") @db.Uuid
  displayName    String?  @map("display_name")
  phone          String?
  marketingOptIn Boolean  @default(false) @map("marketing_opt_in")
  loyaltyTier    String   @default("STANDARD") @map("loyalty_tier")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model MerchantProfile {
  userId             String       @id @map("user_id") @db.Uuid
  businessName       String       @map("business_name")
  legalName          String?      @map("legal_name")
  gstin              String?      @unique @db.VarChar(15)
  panLast4           String?      @map("pan_last4") @db.VarChar(4)
  kycStatus          KycStatus    @default(NOT_SUBMITTED) @map("kyc_status")
  kycProvider        String?      @map("kyc_provider")
  kycReference       String?      @map("kyc_reference")
  encryptedKycData   Json?        @map("encrypted_kyc_data")
  payoutStatus       PayoutStatus @default(NOT_CONFIGURED) @map("payout_status")
  payoutAccountLast4 String?      @map("payout_account_last4") @db.VarChar(4)
  payoutIfsc         String?      @map("payout_ifsc")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kycStatus])
  @@index([payoutStatus])
  @@map("merchant_profiles")
}

model Role {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String               @unique
  name         String
  description  String?
  scope        RoleScope
  isSystem     Boolean              @default(true) @map("is_system")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions  RolePermission[]
  userRoles    UserRoleAssignment[]
  storeMembers StoreMember[]

  @@index([scope])
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique
  description String?
  scope       RoleScope
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@index([scope])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedById String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  user         User      @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([roleId, revokedAt])
  @@map("user_roles")
}

model StoreMember {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String            @map("store_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  roleId          String            @map("role_id") @db.Uuid
  status          StoreMemberStatus @default(PENDING)
  invitedByUserId String?           @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime?         @map("joined_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user            User              @relation("StoreMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role            Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy       User?             @relation("StoreMemberInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([storeId, status])
  @@index([roleId, status])
  @@map("store_members")
}

model AuditLog {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType   String       @map("event_type")
  actor       String?
  actorUserId String?      @map("actor_user_id") @db.Uuid
  storeId     String?      @map("store_id") @db.Uuid
  outcome     AuditOutcome
  metadata    Json         @default("{}")
  ipAddress   String?      @map("ip_address")
  requestId   String?      @map("request_id")
  sessionId   String?      @map("session_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUser   User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  store       Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  session     Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([storeId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model AuditOutbox {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auditLogId String       @map("audit_log_id") @db.Uuid
  eventType  String       @map("event_type")
  payload    Json
  status     OutboxStatus @default(PENDING)
  attempts   Int          @default(0)
  nextRunAt  DateTime     @default(now()) @map("next_run_at") @db.Timestamptz(3)
  lastError  String?      @map("last_error")
