  ipAddress   String?  @map("ip_address")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("phonepe_audit_logs")
}

model Refund {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String       @map("order_id") @db.Uuid
  paymentId          String       @map("payment_id") @db.Uuid
  refundId           String       @unique @map("refund_id")
  cashfreeRefundId   String?      @unique @map("cashfree_refund_id")
  cashfreePaymentId  String?      @map("cashfree_payment_id")
  amountPaise        BigInt       @map("amount_paise")
  currency           String       @default("INR") @db.Char(3)
  status             RefundStatus @default(INITIATED)
  reason             String?
  idempotencyKey     String?      @unique @map("idempotency_key")
  gatewayResponse    Json         @default("{}") @map("gateway_response")
  processedAt        DateTime?    @map("processed_at") @db.Timestamptz(3)
  order              Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment            Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([paymentId, status, createdAt])
  @@index([orderId, createdAt])
  @@map("refunds")
}

model OrderStateTransition {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String      @map("order_id") @db.Uuid
  fromStatus   OrderStatus @map("from_status")
  toStatus     OrderStatus @map("to_status")
  actorType    String      @default("SYSTEM") @map("actor_type")
  actorUserId  String?     @map("actor_user_id") @db.Uuid
  reason       String
  requestId    String?     @map("request_id")
  metadata     Json        @default("{}")
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
  @@map("order_state_transitions")
}

model ReconciliationRun {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId      String               @map("payment_id") @db.Uuid
  reason         ReconciliationReason
  status         ReconciliationStatus @default(PENDING)
  driftCode      String?              @map("drift_code")
  details        Json                 @default("{}")
  attempts       Int                  @default(0)
  nextCheckAt    DateTime             @default(now()) @map("next_check_at") @db.Timestamptz(3)
  resolvedAt     DateTime?            @map("resolved_at") @db.Timestamptz(3)
  lastError      String?              @map("last_error")
  payment        Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, nextCheckAt])
  @@index([reason, status, createdAt])
  @@index([paymentId, createdAt])
  @@map("reconciliation_runs")
}
