  status    StockReservationStatus @default(ACTIVE)
  reason    String?
  expiresAt DateTime               @map("expires_at") @db.Timestamptz(3)
  releasedAt DateTime?             @map("released_at") @db.Timestamptz(3)
  finalizedAt DateTime?            @map("finalized_at") @db.Timestamptz(3)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  variant   ProductVariant         @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productVariantId, status])
  @@index([status, expiresAt])
  @@index([userId, status])
  @@map("stock_reservations")
}

