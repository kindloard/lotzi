  @@unique([productId, sku])
  @@index([productId])
  @@index([productId, isDefault, position])
  @@index([unitGroup, quantityUnit])
  @@index([stockOnHand, stockReserved])
  @@map("product_variants")
}

model ProductImageVariant {
