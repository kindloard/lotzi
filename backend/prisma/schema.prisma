generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  SUSPENDED
  DELETED
}

enum UserProviderType {
  EMAIL
  GOOGLE
  MULTI
}

enum IdentityProviderName {
  GOOGLE
}

enum OtpPurpose {
  EMAIL_SIGNUP
  EMAIL_CHANGE
}

enum SessionRevokedReason {
  LOGOUT
  USER_REVOKED
  PASSWORD_RESET
  TOKEN_REUSE
  ROLE_CHANGED
  ADMIN_REVOKED
  COMPROMISED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
  PENDING
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

enum StoreStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OnboardingLifecycleState {
  PENDING
  BUSINESS_DONE
  BRANDING_DONE
  LEGAL_DONE
  LOCATION_DONE
  PREFS_DONE
  READY_FOR_REVIEW
  LAUNCHED
  APPROVAL_PENDING
  ACTIVE
  SUSPENDED
}

enum OnboardingStep {
  BUSINESS
  BRANDING
  LEGAL
  LOCATION
  PREFERENCES
  REVIEW
}

enum OnboardingValidationStatus {
  DRAFT
  VALID
  INVALID
}

enum StoreMediaKind {
  LOGO
  BANNER
}

enum StoreMediaProvider {
  CLOUDINARY
}

enum StoreMediaStatus {
  TEMP
  VALIDATED
  ATTACHED
  ORPHANED
  REJECTED
}

enum StoreApprovalStatus {
  PENDING
  AUTO_APPROVED
  MANUAL_REVIEW
  REJECTED
}

enum DomainEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum StoreMemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REMOVED
}

enum RoleScope {
  PLATFORM
  STORE
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum PayoutStatus {
  NOT_CONFIGURED
  PENDING
  VERIFIED
  REJECTED
  DISABLED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PACKING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum UploadPurpose {
  PRODUCT_IMAGE
  STORE_LOGO
  STORE_BANNER
  CATEGORY_IMAGE
  USER_AVATAR
}

enum UploadAssetStatus {
  TEMP
  READY
  ATTACHED
  ORPHANED
  REJECTED
}

enum UploadProvider {
  CLOUDINARY
}

enum UploadRenditionKind {
  THUMBNAIL
  CARD
  DETAIL
  ZOOM
  JPEG_FALLBACK
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  PAUSED
  NEEDS_REVIEW
}

enum UnitGroup {
  WEIGHT
  VOLUME
  COUNT
  LENGTH
  AREA
  BUNDLE
}

enum MeasurementUnit {
  MG
  G
  KG
  TONNE
  ML
  LITRE
  GALLON
  PIECE
  PAIR
  DOZEN
  CM
  METER
  INCH
  FEET
  SQ_FT
  SQ_METER
}

enum PackType {
  UNIT
  PACK
  PACKET
  BOX
  CARTON
  BOTTLE
  POUCH
  JAR
  CAN
  SACHET
  STRIP
  BAG
  TRAY
  BUNCH
  BUNDLE
  SET
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  FINALIZED
  EXPIRED
}

model User {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String           @unique @db.Citext
  fullName          String?          @map("full_name")
  passwordHash      String?          @map("password_hash")
  providerType      UserProviderType @default(EMAIL) @map("provider_type")
  emailVerified     Boolean          @default(false) @map("email_verified")
  avatarUrl         String?          @map("avatar_url")
  status            UserStatus       @default(PENDING)
  phone             String?
  loginCount        Int              @default(0) @map("login_count")
  failedAttempts    Int              @default(0) @map("failed_attempts")
  lockedUntil       DateTime?        @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?        @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?        @map("password_changed_at") @db.Timestamptz(3)
  authzVersion      Int              @default(1) @map("authz_version")
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  addresses               Address[]
  carts                   Cart[]
  orders                  Order[]
  stockReservations       StockReservation[]
  identityProviders       IdentityProvider[]
  otpVerifications        OtpVerification[]
  sessions                Session[]
  passwordResets          PasswordReset[]
  customerProfile         CustomerProfile?
  merchantProfile         MerchantProfile?
  accountDeletionRequests AccountDeletionRequest[]
  createdStores           Store[]               @relation("StoreCreatedBy")
  approvedStores          Store[]               @relation("StoreApprovedBy")
  userRoles               UserRoleAssignment[]  @relation("UserRoleUser")
  assignedUserRoles       UserRoleAssignment[]  @relation("UserRoleAssignedBy")
  storeMemberships        StoreMember[]         @relation("StoreMemberUser")
  invitedStoreMemberships StoreMember[]         @relation("StoreMemberInvitedBy")
  auditLogs               AuditLog[]            @relation("AuditActor")
  uploadedStoreMedia      StoreMedia[]          @relation("StoreMediaUploadedBy")
  uploadedAssets          UploadAsset[]         @relation("UploadAssetUploadedBy")
  idempotencyKeys         IdempotencyKey[]       @relation("IdempotencyKeyUser")
  reviewedStoreApprovals  StoreApprovalReview[] @relation("StoreApprovalReviewedBy")

  @@index([email, status])
  @@index([status])
  @@map("users")
}

model IdentityProvider {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  provider       IdentityProviderName
  providerUserId String               @map("provider_user_id")
  providerEmail  String               @map("provider_email") @db.Citext
  metadata       Json                 @default("{}")
  linkedAt       DateTime             @default(now()) @map("linked_at") @db.Timestamptz(3)
  lastLoginAt    DateTime?            @map("last_login_at") @db.Timestamptz(3)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([providerEmail])
  @@map("identity_providers")
}

model OtpVerification {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  email         String     @db.Citext
  otpHash       String     @map("otp_hash")
  otpNonce      String     @map("otp_nonce")
  purpose       OtpPurpose
  metadata      Json       @default("{}")
  verified      Boolean    @default(false)
  verifiedAt    DateTime?  @map("verified_at") @db.Timestamptz(3)
  attemptCount  Int        @default(0) @map("attempt_count")
  sendCount     Int        @default(1) @map("send_count")
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz(3)
  cooldownUntil DateTime?  @map("cooldown_until") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId, purpose, verified, expiresAt])
  @@map("otp_verifications")
}

model Session {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  tokenFamilyId     String                @map("token_family_id") @db.Uuid
  refreshTokenHash  String                @unique @map("refresh_token_hash")
  refreshTokenJti   String?               @map("refresh_token_jti") @db.VarChar(64)
  refreshTokenParentJti String?           @map("refresh_token_parent_jti") @db.VarChar(64)
  refreshTokenIssuedAt DateTime?          @map("refresh_token_issued_at") @db.Timestamptz(3)
  clientSecretHash  String?               @map("client_secret_hash") @db.VarChar(128)
  deviceFingerprint String                @map("device_fingerprint")
  deviceMetadata    Json?                 @map("device_metadata")
  ipAddress         String?               @map("ip_address")
  userAgent         String?               @map("user_agent")
  expiresAt         DateTime              @map("expires_at") @db.Timestamptz(3)
  persistent        Boolean               @default(true)
  revoked           Boolean               @default(false)
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(3)
  revokedReason     SessionRevokedReason? @map("revoked_reason")
  lastSeenAt        DateTime              @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHistory    RefreshTokenHistory[]
  auditLogs         AuditLog[]

  @@index([userId, revoked, expiresAt])
  @@index([tokenFamilyId, revoked])
  @@index([tokenFamilyId, refreshTokenJti])
  @@index([deviceFingerprint])
  @@map("sessions")
}

model RefreshTokenHistory {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String    @map("session_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenFamilyId    String    @map("token_family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  refreshTokenJti  String?   @map("refresh_token_jti") @db.VarChar(64)
  replacementRefreshTokenJti String? @map("replacement_refresh_token_jti") @db.VarChar(64)
  deviceFingerprint String?  @map("device_fingerprint") @db.VarChar(128)
  consumedAt       DateTime  @default(now()) @map("consumed_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  reuseDetectedAt  DateTime? @map("reuse_detected_at") @db.Timestamptz(3)
  session          Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tokenFamilyId, expiresAt])
  @@index([userId, consumedAt])
  @@index([sessionId, refreshTokenJti])
  @@map("refresh_token_history")
}

model PasswordReset {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  selector      String    @unique
  verifierHash  String    @map("verifier_hash")
  verifierNonce String    @map("verifier_nonce")
  requestedIp   String?   @map("requested_ip")
  userAgentHash String?   @map("user_agent_hash")
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@map("password_resets")
}

model CustomerProfile {
  userId         String   @id @map("user_id") @db.Uuid
  displayName    String?  @map("display_name")
  phone          String?
  marketingOptIn Boolean  @default(false) @map("marketing_opt_in")
  loyaltyTier    String   @default("STANDARD") @map("loyalty_tier")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model MerchantProfile {
  userId             String       @id @map("user_id") @db.Uuid
  businessName       String       @map("business_name")
  legalName          String?      @map("legal_name")
  gstin              String?      @unique @db.VarChar(15)
  panLast4           String?      @map("pan_last4") @db.VarChar(4)
  kycStatus          KycStatus    @default(NOT_SUBMITTED) @map("kyc_status")
  kycProvider        String?      @map("kyc_provider")
  kycReference       String?      @map("kyc_reference")
  encryptedKycData   Json?        @map("encrypted_kyc_data")
  payoutStatus       PayoutStatus @default(NOT_CONFIGURED) @map("payout_status")
  payoutAccountLast4 String?      @map("payout_account_last4") @db.VarChar(4)
  payoutIfsc         String?      @map("payout_ifsc")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kycStatus])
  @@index([payoutStatus])
  @@map("merchant_profiles")
}

model Role {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String               @unique
  name         String
  description  String?
  scope        RoleScope
  isSystem     Boolean              @default(true) @map("is_system")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions  RolePermission[]
  userRoles    UserRoleAssignment[]
  storeMembers StoreMember[]

  @@index([scope])
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique
  description String?
  scope       RoleScope
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@index([scope])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedById String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  user         User      @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy   User?     @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([roleId, revokedAt])
  @@map("user_roles")
}

model StoreMember {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String            @map("store_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  roleId          String            @map("role_id") @db.Uuid
  status          StoreMemberStatus @default(PENDING)
  invitedByUserId String?           @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime?         @map("joined_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user            User              @relation("StoreMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role            Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy       User?             @relation("StoreMemberInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([storeId, status])
  @@index([roleId, status])
  @@map("store_members")
}

model AuditLog {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType   String       @map("event_type")
  actor       String?
  actorUserId String?      @map("actor_user_id") @db.Uuid
  storeId     String?      @map("store_id") @db.Uuid
  outcome     AuditOutcome
  metadata    Json         @default("{}")
  ipAddress   String?      @map("ip_address")
  requestId   String?      @map("request_id")
  sessionId   String?      @map("session_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUser   User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  store       Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  session     Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([storeId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model AuditOutbox {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auditLogId String       @map("audit_log_id") @db.Uuid
  eventType  String       @map("event_type")
  payload    Json
  status     OutboxStatus @default(PENDING)
  attempts   Int          @default(0)
  nextRunAt  DateTime     @default(now()) @map("next_run_at") @db.Timestamptz(3)
  lastError  String?      @map("last_error")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt     DateTime?    @map("sent_at") @db.Timestamptz(3)

  @@index([status, nextRunAt])
  @@map("audit_outbox")
}

model EmailOutbox {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toEmail        String       @map("to_email") @db.Citext
  template       String
  subject        String
  payload        Json
  idempotencyKey String?      @unique @map("idempotency_key")
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt         DateTime?    @map("sent_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([toEmail, createdAt])
  @@map("email_outbox")
}

model Address {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  label                String?
  recipientName        String?   @map("recipient_name")
  recipientPhone       String?   @map("recipient_phone")
  line1                String
  line2                String?
  city                 String
  state                String
  pincode              String
  latitude             Decimal?  @db.Decimal(10, 7)
  longitude            Decimal?  @db.Decimal(10, 7)
  deliveryInstructions String?   @map("delivery_instructions")
  isDefault            Boolean   @default(false) @map("is_default")
  version              Int       @default(1)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders               Order[]
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, deletedAt, updatedAt])
  @@map("addresses")
}

model AccountDeletionRequest {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  confirmationHash String @map("confirmation_hash")
  confirmationNonce String @map("confirmation_nonce")
  requestedIp   String?   @map("requested_ip")
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  cooldownUntil DateTime? @map("cooldown_until") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@map("account_deletion_requests")
}

model Store {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdByUserId     String                 @map("created_by_user_id") @db.Uuid
  approvedByUserId    String?                @map("approved_by_user_id") @db.Uuid
  name                String
  legalName           String?                @map("legal_name")
  slug                String                 @unique @db.Citext
  description         String?
  phone               String?
  email               String?                @db.Citext
  addressLine         String?                @map("address_line")
  city                String?
  state               String?
  pincode             String?
  latitude            Decimal?               @db.Decimal(10, 7)
  longitude           Decimal?               @db.Decimal(10, 7)
  status              StoreStatus            @default(PENDING)
  isDeliveryAvailable Boolean                @default(false) @map("is_delivery_available")
  openingTime         String?                @map("opening_time")
  closingTime         String?                @map("closing_time")
  imageUrl            String?                @map("image_url")
  approvedAt          DateTime?              @map("approved_at") @db.Timestamptz(3)
  rejectionReason     String?                @map("rejection_reason")
  deletedAt           DateTime?              @map("deleted_at") @db.Timestamptz(3)
  createdBy           User                   @relation("StoreCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy          User?                  @relation("StoreApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  members             StoreMember[]
  products            Product[]
  orders              Order[]
  carts               Cart[]
  auditLogs           AuditLog[]
  businessProfile     StoreBusinessProfile?
  branding            StoreBranding?
  settings            StoreSettings?
  onboardingState     StoreOnboardingState?
  onboardingDrafts    StoreOnboardingDraft[]
  media               StoreMedia[]
  uploadAssets        UploadAsset[]
  idempotencyKeys     IdempotencyKey[]
  approvalReviews     StoreApprovalReview[]
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdByUserId, status])
  @@index([status, deletedAt])
  @@map("stores")
}

model StoreBusinessProfile {
  storeId            String   @id @map("store_id") @db.Uuid
  businessName       String   @map("business_name")
  category           String?
  businessType       String?  @map("business_type")
  country            String   @default("IN") @db.VarChar(2)
  legalName          String?  @map("legal_name")
  taxId              String?  @map("tax_id") @db.VarChar(64)
  gstin              String?  @db.VarChar(15)
  registrationNumber String?  @map("registration_number")
  addressLine        String?  @map("address_line")
  city               String?
  state              String?
  pincode            String?
